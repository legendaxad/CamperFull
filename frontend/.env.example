# Backend API base URL (including /api/v1). Leave empty in development to use the Vite proxy (/api/v1).
# Production example: VITE_API_BASE_URL=https://api.fullcamper.example/api/v1
VITE_API_BASE_URL=

# Development only: where the Vite dev server proxies /api requests (the backend PORT).
VITE_DEV_API_PROXY=http://localhost:8080
