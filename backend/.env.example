# ---------------------------------------------------------------
# FullCamper backend configuration
# Copy to .env and fill in. Never commit the real .env file.
# ---------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of reverse proxies in front of the app (e.g. 1 behind Nginx/a load balancer). 0 = none.
TRUST_PROXY=0

# MongoDB must be a replica set (Atlas always is) because bookings use transactions.
# Local example: mongodb://127.0.0.1:27017/fullcamper?replicaSet=rs0
MONGODB_URI=

# JWT secrets: long random strings (>= 32 chars in production), different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Browser apps allowed to call the API with cookies (CORS + CSRF origin check).
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
# Optional comma-separated additional origins, e.g. a staging site.
CORS_EXTRA_ORIGINS=

# Cookies. Use COOKIE_SAME_SITE=none (with HTTPS) only if the API is on a different site than the apps.
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
# Defaults to true in production. Must be true when COOKIE_SAME_SITE=none.
COOKIE_SECURE=

# Rate limiting
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=300

# Cloudinary (image uploads). Uploads return 503 until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fullcamper

# Payments: "toss" (Toss Payments, required in production) or "mock" (development/tests only).
PAYMENT_PROVIDER=mock
# Toss Payments secret key (test keys start with test_sk_). The client key belongs in the frontend.
TOSS_SECRET_KEY=
TOSS_API_BASE_URL=https://api.tosspayments.com

# SMTP for password-reset emails. Without it, emails are only logged in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FullCamper <no-reply@fullcamper.local>

# Used only by `npm run create-admin`
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
